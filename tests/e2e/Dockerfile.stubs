# The stand-ins of the end-to-end stack: an OpenAI-compatible model, an MCP server and the test runner.
FROM python:3.12-slim
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install "fastapi>=0.115,<1" "uvicorn>=0.32,<1" "mcp>=1.9,<2" "httpx>=0.27,<1" "pytest>=8,<10" "pytest-asyncio>=0.24,<2"
WORKDIR /e2e
COPY . /e2e
